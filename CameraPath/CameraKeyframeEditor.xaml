<UserControl x:Class="CameraPath.CameraKeyframeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:local="clr-namespace:CameraPath"
             Name="this">
  <UserControl.Resources>
    <!-- 上下にドラッグして高さを変えるためのつまみ -->
    <Style x:Key="ResizeHandle" TargetType="{x:Type Thumb}">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Cursor" Value="SizeNS"/>
      <Setter Property="ToolTip" Value="ドラッグで高さを変えられます"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="bar" Background="#333842"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bar" Property="Background" Value="#5A6474"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 設定点ひとつ分の行 -->
    <DataTemplate x:Key="PointRowTemplate">
      <StackPanel Margin="0,1">
        <TextBlock FontSize="11">
          <Run Text="F:"/><Run Text="{Binding Path=Frame.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/>
          <Run Text=" 位置("/>
          <Run Text="{Binding Path=X.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=","/>
          <Run Text="{Binding Path=Y.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=","/>
          <Run Text="{Binding Path=Z.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=")"/>
        </TextBlock>
        <TextBlock FontSize="11" Opacity="0.7">
          <Run Text="角度("/>
          <Run Text="{Binding Path=RotationX.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text=","/>
          <Run Text="{Binding Path=RotationY.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text=","/>
          <Run Text="{Binding Path=RotationZ.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text="°) 視野角 "/>
          <Run Text="{Binding Path=Fov.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text="°"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <!-- 設定点と設定点の間の、時間カーブの行 -->
    <DataTemplate x:Key="SegmentRowTemplate">
      <StackPanel Orientation="Horizontal">
        <Path Width="52" Height="16" Stretch="None" StrokeThickness="1.4" VerticalAlignment="Center"
              Data="{Binding CurveGeometry}" Stroke="{Binding StrokeBrush}"/>
        <TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Opacity="0.85">
          <Run Text="区間 "/><Run Text="{Binding NumberText, Mode=OneWay}"/>
          <Run Text="   F"/><Run Text="{Binding From.Frame.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/>
          <Run Text=" → F"/><Run Text="{Binding To.Frame.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="listRow" Height="150" MinHeight="60"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="previewRow" Height="350" MinHeight="150"/>
      <RowDefinition Height="6"/>
    </Grid.RowDefinitions>

    <!-- 設定点リスト。設定点の行の間に、区間の時間カーブの行が挟まる -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="30"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer x:Name="listScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="rowsPanel" Margin="0,1"/>
      </ScrollViewer>

      <!-- 設定点の数・並びを変えるボタン -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="addButton" Content="＋" Click="AddButton_Click" ToolTip="設定点を追加します"/>
        <Button Grid.Row="1" x:Name="removeButton" Content="－" Click="RemoveButton_Click" ToolTip="選択中の設定点を削除します（Ctrl+クリックで複数選択したときは、まとめて削除）"/>
        <Button Grid.Row="2" x:Name="upButton" Content="▲" Click="UpButton_Click" ToolTip="選択中の設定点をひとつ上へ"/>
        <Button Grid.Row="3" x:Name="downButton" Content="▼" Click="DownButton_Click" ToolTip="選択中の設定点をひとつ下へ"/>
      </Grid>

      <!-- 軌道を作りかえるボタン（複製・反転・ループ） -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="duplicateButton" Content="▣" Click="DuplicateButton_Click" ToolTip="選択中の設定点を複製して、30フレーム後に置きます"/>
        <Button Grid.Row="1" x:Name="reverseButton" Content="⇅" Click="ReverseButton_Click" ToolTip="軌道全体を逆向きにします（時刻も反転するので、同じ時間幅で逆再生の動きになります）"/>
        <Button Grid.Row="2" x:Name="loopButton" Content="↺" Click="LoopButton_Click" ToolTip="軌道の終点から始点へ戻る点を足して、往復する動きにします"/>
      </Grid>
    </Grid>

    <!-- リストの下の縁。上下にドラッグするとリストの高さが変わる -->
    <Thumb Grid.Row="1" x:Name="listResizeThumb" Style="{StaticResource ResizeHandle}"
           DragDelta="ListResizeThumb_DragDelta"/>

    <!-- リストで選んだ区間の時間カーブ。リストの外の下に出す -->
    <Border Grid.Row="2" x:Name="segmentPanel" Visibility="Collapsed" Margin="0,4,0,0"
            BorderBrush="#66FFC46B" BorderThickness="1,0,0,0" Padding="6,2,0,6">
      <StackPanel>
        <TextBlock x:Name="segmentHeader" FontSize="11" Opacity="0.85"/>
        <Grid x:Name="segmentHost" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- 選択中の設定点の設定 -->
    <Grid Grid.Row="3" ClipToBounds="True">
      <ctrl:PropertiesEditor x:Name="pointEditor" Margin="0,-22,0,0"
                             BeginEdit="Editor_BeginEdit" EndEdit="Editor_EndEdit"
                             Targets="{Binding ElementName=this, Path=TargetKeyframes}"/>
    </Grid>

    <!-- 3Dプレビュー。設定点や制御点をここで直接つかんで動かせる -->
    <local:CameraPathPreview Grid.Row="4" x:Name="preview"
                             BeginEdit="Editor_BeginEdit" EndEdit="Editor_EndEdit"/>

    <!-- 3Dプレビューの下の縁。上下にドラッグするとプレビューの高さが変わる -->
    <Thumb Grid.Row="5" x:Name="previewResizeThumb" Style="{StaticResource ResizeHandle}"
           DragDelta="PreviewResizeThumb_DragDelta"/>
  </Grid>
</UserControl>
