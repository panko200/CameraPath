<UserControl x:Class="CameraPath.CameraPathPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="200">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
      <Button x:Name="resetButton" Content="視点リセット" Padding="8,2" Margin="0,0,4,0" Click="ResetButton_Click"/>
      <Button x:Name="fitButton" Content="軌道にフィット" Padding="8,2" Margin="0,0,4,0" Click="FitButton_Click"/>
      <Button x:Name="playButton" Content="▶ 再生" Padding="8,2" Margin="0,0,8,0" Click="PlayButton_Click"
              ToolTip="この3D表示の中で、軌道にそったカメラの動きを再生します（タイムラインのフレームは動きません）"/>
      <TextBlock x:Name="statusText" VerticalAlignment="Center" FontSize="11" Foreground="#8A93A3"/>
    </StackPanel>

    <!--背景はここで塗る。奥からアイテムの絵（3D）→軌道の線（2D）の順に重なる-->
    <Border Grid.Row="1" x:Name="viewportHost" Background="#12141A" BorderBrush="#333842" BorderThickness="1"
            ClipToBounds="True" MinHeight="180"/>

    <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="10" Foreground="#7A828F" TextWrapping="Wrap"
               Text="ドラッグ=回転 / Shift+ドラッグ または 中ドラッグ=平行移動 / ホイール=拡大縮小&#x0a;赤=X（右）　緑=Y（下）　青=Z（手前）　オレンジ=軌道　水色=現在のカメラ&#x0a;青緑のツメ=軌道の接線（制御点）。二次・三次ベジェのときに出て、つかんで動かせます&#x0a;黄緑の線と十字=注視点。「注視点を使う」がONのときに出て、つかんで動かせます&#x0a;紫枠=このエフェクトが効いているアイテム　青灰枠=その他のアイテム（中身をそのまま表示）&#x0a;グレー=アイテムが描かれる面　アイテムはカメラを掛ける前の位置に並びます&#x0a;リストでCtrl+クリックすると複数の設定点を選べて、ここでつかむとまとめて動かせます"/>
  </Grid>
</UserControl>
